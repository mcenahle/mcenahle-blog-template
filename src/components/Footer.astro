---
import { Icon } from "astro-icon/components";
---

<footer>
  <div class="container" style="margin-bottom: 0px;">
    <div class="row">
      <div class="col-sm-8 footer-text-left">
        <p>
          <div class="dropup">
            <button
              class="btn btn-default btn-sm dropdown-toggle"
              type="button"
              id="menu1"
              data-toggle="dropdown"
              ><Icon name="mdi:link-variant" /> 友情链接&nbsp;
              <span class="caret"></span></button
            >
            <ul class="dropdown-menu" role="menu" aria-labelledby="menu1">
              <li role="presentation" class="dropdown-header">推荐链接</li>
              <li role="presentation">
                <a
                  role="menuitem"
                  tabindex="-1"
                  href="https://www.david03.top/"
                  target="_blank"
                  >Davidの3号基地 <Icon name="mdi:open-in-new" /></a
                >
              </li>
              <li role="presentation">
                <a
                  role="menuitem"
                  tabindex="-1"
                  href="https://www.iczrx.cn/"
                  target="_blank"
                  >晚夜的个人博客 <Icon name="mdi:open-in-new" /></a
                >
              </li>
              <li role="presentation" class="divider"></li>
              <li role="presentation" class="dropdown-header">生活类</li>
              <li role="presentation">
                <a
                  role="menuitem"
                  tabindex="-1"
                  href="https://vjo.cc/"
                  target="_blank">刘郎阁 <Icon name="mdi:open-in-new" /></a
                >
              </li>
              <li role="presentation">
                <a
                  role="menuitem"
                  tabindex="-1"
                  href="https://oba.by/"
                  target="_blank">obaby <Icon name="mdi:open-in-new" /></a
                >
              </li>
              <li role="presentation">
                <a
                  role="menuitem"
                  tabindex="-1"
                  href="https://imqi1.com/"
                  target="_blank">ImQi1 / 棋 <Icon name="mdi:open-in-new" /></a
                >
              </li>
              <li role="presentation">
                <a
                  role="menuitem"
                  tabindex="-1"
                  href="https://blog.真寻.top/"
                  target="_blank">兔兔博客🇨🇳 <Icon name="mdi:open-in-new" /></a
                >
              </li>
            </ul>
            <a href="/link/" style="margin-left: 10px;"
              ><u>申请/修改友情链接</u> <Icon name="mdi:arrow-top-right" /></a
            >
          </div>
        </p>
        <p>
          <img
            src="https://i.mcenahle.page/not-by-ai-resources/Photographed By Human/_SVG/Photographed-By-Human-Not-By-AI-Badge-white.svg"
            alt="Photographed By Human Badge"
            width="80"
            style="margin-right: 12px;"
          />
          <img
            src="https://i.mcenahle.page/not-by-ai-resources/Written By Human/_SVG/Written-By-Human-Not-By-AI-Badge-white.svg"
            alt="Written By Human Badge"
            width="80"
            style="margin-right: 12px;"
          />
        </p>
        <p>© 2026 blog.mcenahle.dev. Powered by Astro. Hosted by Cloudflare.</p>
        <p>
          <Icon name="mdi:place" /> 背景图片拍摄地：东方绿舟（<a
            href="https://ogb.shec.edu.cn"
            target="_blank"
          >
            <u>ogb.shec.edu.cn</u> <Icon name="mdi:open-in-new" /></a
          >）。
        </p>
      </div>

      <div class="col-sm-4 text-rightWord">
        <div>
          <p id="footer-right-border">
            <Icon name="mdi:email-arrow-right" /> 电子邮件地址：<a
              href="mailto:hi@mcenahle.page"
              target="_blank"
            >
              <u>hi@mcenahle.page</u> <Icon name="mdi:open-in-new" /></a
            >
          </p>
        </div>
      </div>
    </div>
  </div>
</footer>
