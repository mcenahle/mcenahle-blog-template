---
import Navbar from "../components/Navbar.astro";
import Layout from "./Layout.astro";
import { Icon } from "astro-icon/components";

interface Place {
  name: string;
  date?: string;
  note?: string;
}

interface Frontmatter {
  title: string;
  description?: string;
  pubDate?: string | Date;
  location?: Place[];
  originalLink?: string;
}

interface Props {
  frontmatter: Frontmatter;
}

const { frontmatter } = Astro.props;
---

<Navbar />

<Layout title={frontmatter.title} description={frontmatter.description}>
  <div class="container">
    <ul class="breadcrumb">
      <li><a href="/">natsume</a></li>
      <li class="active">{frontmatter.title}</li>
    </ul>
    <div class="post">
      <div class="panel panel-default">
        <div class="page-heading" style="padding:15px">
          <h2>
            {frontmatter.title}
            <small style="margin-left: 12px;"
              ><Icon name="mdi:calendar-month-outline" />&nbsp;{
                frontmatter.pubDate
              }</small
            >
          </h2>
          <div class="dropdown">
            <button
              class="btn btn-primary dropdown-toggle"
              type="button"
              id="ai-read"
              data-toggle="dropdown"
              ><Icon name="ri:ai" /> AI 阅读文章
              <span class="caret"></span></button
            >
            <ul class="dropdown-menu" role="menu" aria-labelledby="ai-read">
              <li role="presentation">
                <a
                  role="menuitem"
                  tabindex="-1"
                  href="#"
                  onclick="openInChatgpt()"
                  ><Icon name="ri:openai-fill" /> 在 ChatGPT 中打开 <Icon
                    name="mdi:open-in-new"
                  /></a
                >
              </li>
              <li role="presentation">
                <a
                  role="menuitem"
                  tabindex="-1"
                  href="https://gemini.google.com"
                  target="_blank"
                  ><Icon name="ri:gemini-fill" /> 在 Gemini 中打开 <Icon
                    name="mdi:open-in-new"
                  /></a
                >
              </li>
              <li role="presentation" class="disabled">
                <a
                  role="menuitem"
                  style="background-color: rgb(255, 170, 170); color: white;"
                  tabindex="-1"
                  href="#"
                  data-toggle="modal"
                  data-target="#noclaudeModal"
                >
                  <Icon name="ri:claude-fill" /> 在 Claude 中打开 <Icon
                    name="mdi:open-in-new"
                  />
                </a>
              </li>
            </ul>
          </div>
        </div>

        <script is:inline>
          function openInChatgpt() {
            const URL = window.location.href;
            window.open(
              "https://chatgpt.com/?prompt=阅读 " + URL + " 然后回答这个问题：",
            );
          }
        </script>

        <div
          class="modal fade"
          id="noclaudeModal"
          tabindex="-1"
          role="dialog"
          aria-labelledby="noclaudeModalLabel"
          aria-hidden="true"
        >
          <div class="modal-dialog">
            <div class="modal-content">
              <div class="modal-header">
                <button
                  type="button"
                  class="close"
                  data-dismiss="modal"
                  aria-hidden="true"
                >
                  &times;
                </button>
                <h4 class="modal-title" id="noclaudeModalLabel">
                  “在 Claude 中打开”不可用。
                </h4>
              </div>
              <div class="modal-body">
                <p>“在 Claude 中打开”不可用。</p>
                <p>
                  Claude Compatibility Layer™
                  检测到您可能正在呼吸。在继续之前，请完成身份验证（KYC）、年龄验证、地区验证、人格验证以及您确实是您本人验证。
                </p>
                <p>
                  <b style="color:brown"
                    >注意：本网站实际上不提供、也不需要任何上述验证。这是一个讽刺性提示。请勿向本网站提交身份证件，我们收了也不知道拿它干什么。本网站不会收集上述任何信息，因为我们也不知道为什么让
                    AI 阅读一篇博客文章需要这些。</b
                  >
                </p>
              </div>
              <div class="modal-footer">
                <a
                  href="https://support.claude.com/zh-CN/articles/14328960-claude-%E4%B8%8A%E7%9A%84%E8%BA%AB%E4%BB%BD%E9%AA%8C%E8%AF%81"
                  target="_blank"
                  rel="noreferrer"
                  class="btn btn-danger"
                  role="button"
                  >了解 Claude 的身份验证规则 <Icon name="mdi:open-in-new" /></a
                >
                <button
                  type="button"
                  class="btn btn-default"
                  data-dismiss="modal"
                  >关闭
                </button>
              </div>
            </div><!-- /.modal-content -->
          </div><!-- /.modal -->
        </div>

        <div class="panel-body">
          <div class="alert alert-info">
            <p><Icon name="mdi:information-outline" /> <b>文章阅读引言</b></p>
            <p>{frontmatter.description}</p>
          </div>
          <div class="article">
            <slot />
          </div>
          {
            frontmatter.location && (
              <>
                <p id="placeShow">
                  <small>
                    <Icon name="mdi:map-marker-radius-outline" />{" "}
                    在撰写本文（或之前），作者去过了：
                  </small>
                  {frontmatter.location.map((place, index) => (
                    <button
                      type="button"
                      class="btn btn-info btn-sm"
                      data-toggle="modal"
                      data-target={`#placeModal-${index}`}
                      style="margin-left: 6px;"
                    >
                      📍 {place.name}
                    </button>
                  ))}
                  <span style="margin-left:6px">。</span>
                </p>
                {frontmatter.location.map((place, index) => (
                  <div
                    class="modal fade"
                    id={`placeModal-${index}`}
                    tabindex="-1"
                    role="dialog"
                    aria-labelledby="placeModalLabel"
                    aria-hidden="true"
                  >
                    <div class="modal-dialog">
                      <div class="modal-content">
                        <div class="modal-header">
                          <button
                            type="button"
                            class="close"
                            data-dismiss="modal"
                            aria-hidden="true"
                          >
                            &times;
                          </button>
                          <h4 class="modal-title" id="placeModalLabel">
                            {place.name}
                          </h4>
                        </div>
                        <div class="modal-body">
                          <p>{place.date}</p>
                          <p>{place.note}</p>
                        </div>
                        <div class="modal-footer">
                          <button
                            type="button"
                            class="btn btn-default"
                            data-dismiss="modal"
                          >
                            关闭
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                ))}
              </>
            )
          }
          <hr style="margin-top: 24px;" />
          <a class="btn btn-primary" href="/" role="button"
            ><Icon name="mdi:arrow-left" /> 返回</a
          >
          {
            frontmatter.originalLink && (
              <a
                href={frontmatter.originalLink}
                target="_blank"
                class="btn btn-default"
                role="button"
                style="margin-left: 12px;"
              >
                查看参考文章 <Icon name="mdi:open-in-new" />
              </a>
            )
          }
        </div>
      </div>
      <div id="tcomment"></div>
    </div>
  </div>
</Layout>

<script
  src="https://registry.npmmirror.com/twikoo/1.7.9/files/dist/twikoo.min.js"
  is:inline></script>
<script is:inline>
  twikoo.init({
    envId: "https://twikoo.mcenahle.page/.netlify/functions/twikoo", // 腾讯云环境填 envId；Vercel 环境填地址（https://xxx.vercel.app）
    el: "#tcomment", // 容器元素
    // region: "ap-shanghai", // 环境地域，默认为 ap-shanghai，腾讯云环境填 ap-shanghai 或 ap-guangzhou；Vercel 环境不填
    // path: location.pathname, // 用于区分不同文章的自定义 js 路径，如果您的文章路径不是 location.pathname，需传此参数
    lang: "zh-CN", // 用于手动设定评论区语言，支持的语言列表 https://github.com/twikoojs/twikoo/blob/main/src/client/utils/i18n/index.js
  });
</script>
