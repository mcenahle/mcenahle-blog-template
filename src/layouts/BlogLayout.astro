---
import Navbar from "../components/Navbar.astro";
import Layout from "./Layout.astro";
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  pubDate: string;
  slug: string;
  description: string;
  originalLink: string;
}

const { title, pubDate, slug, description, originalLink = "" } = Astro.props;
---

<Navbar />

<Layout title={title} description={description}>
  <div class="container">
    <ul class="breadcrumb">
      <li><a href="/">blog.mcenahle.dev</a></li>
      <li class="active">{title}</li>
    </ul>
    <div class="post">
      <div class="panel panel-default">
        <div class="page-heading" style="padding:15px">
          <h2>
            {title}
            <small style="margin-left: 12px;"
              ><Icon name="mdi:calendar-month-outline" />&nbsp;{pubDate}</small
            >
          </h2>
        </div>
        <div class="panel-body">
          <div class="alert alert-info">
            <p><Icon name="mdi:information-outline" /> <b>文章阅读引言</b></p>
            <p>{description}</p>
          </div>
          <div class="article">
            <slot />
          </div>
          <hr style="margin-top: 24px;" />
          <a class="btn btn-primary" href="/" role="button"
            ><Icon name="mdi:arrow-left" /> 返回</a
          >
          <a
            href={originalLink}
            target="_blank"
            class="btn btn-default"
            role="button"
            style="margin-left: 12px;"
            >查看原始博客文章 <Icon name="mdi:open-in-new" /></a
          >
        </div>
      </div>
      <div id="tcomment"></div>
    </div>
  </div>
</Layout>

<script
  src="https://registry.npmmirror.com/twikoo/1.7.9/files/dist/twikoo.min.js"
  is:inline></script>
<script is:inline>
  twikoo.init({
    envId: "https://twikoo.mcenahle.page/.netlify/functions/twikoo", // 腾讯云环境填 envId；Vercel 环境填地址（https://xxx.vercel.app）
    el: "#tcomment", // 容器元素
    // region: "ap-shanghai", // 环境地域，默认为 ap-shanghai，腾讯云环境填 ap-shanghai 或 ap-guangzhou；Vercel 环境不填
    // path: location.pathname, // 用于区分不同文章的自定义 js 路径，如果您的文章路径不是 location.pathname，需传此参数
    lang: "zh-CN", // 用于手动设定评论区语言，支持的语言列表 https://github.com/twikoojs/twikoo/blob/main/src/client/utils/i18n/index.js
  });
</script>
