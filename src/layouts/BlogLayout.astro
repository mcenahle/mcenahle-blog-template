---
import Navbar from "../components/Navbar.astro";
import Layout from "./Layout.astro";
import { Icon } from "astro-icon/components";
import "../styles/global.scss";

interface Props {
  title: string;
  date: string;
  description: string;
  originalLink: string;
}

const { title, date, description, originalLink = "" } = Astro.props;
---

<Navbar />

<Layout title={title} description={description}>
  <div class="container">
    <ul class="breadcrumb">
      <li><a href="/">blog.mcenahle.dev</a></li>
      <li class="active">{title}</li>
    </ul>
    <div class="post">
      <div class="panel panel-default">
        <div class="page-heading" style="padding:15px">
          <h2>
            {title}
            <small style="margin-left: 12px;"
              ><Icon name="mdi:calendar-month-outline" />&nbsp;{date}</small
            >
          </h2>
        </div>
        <div class="panel-body">
          <div class="alert alert-info">
            <p><Icon name="mdi:information-outline" /> <b>文章阅读引言</b></p>
            <p>{description}</p>
          </div>
          <div class="article">
            <slot />
          </div>
          <hr style="margin-top: 24px;" />
          <a class="btn btn-primary" href="/" role="button"
            ><Icon name="mdi:arrow-left" /> 返回</a
          >
          <a
            href={originalLink}
            target="_blank"
            class="btn btn-default"
            role="button"
            style="margin-left: 12px;"
            >查看原始博客文章 <Icon name="mdi:open-in-new" /></a
          >
        </div>
      </div>
    </div>
  </div>
</Layout>
