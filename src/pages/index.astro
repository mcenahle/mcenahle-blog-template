---
import Navbar from "../components/Navbar.astro";
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";

const allPosts = Object.values(
  import.meta.glob("../posts/*.md", { eager: true }),
).sort(
  (a: any, b: any) =>
    new Date(b.frontmatter.pubDate).getTime() -
    new Date(a.frontmatter.pubDate).getTime(),
);
---

<Navbar />

<Layout title="主页">
  <div class="container">
    <div class="post">
      <div class="border-bottom">
        <h2 class="text-black">natsume</h2>

        <p>一个来自 Mcenahle 搭建的 Astro 网站主题。</p>

        <div class="list-group">
          {
            allPosts.map((post: any) => {
              const [year, month, day] = post.frontmatter.pubDate.split("-");

              const url = `/${year}/${month}/${day}/${post.frontmatter.slug}/`;

              return (
                <a href={url} class="list-group-item">
                  <h4 class="list-group-item-heading">
                    {post.frontmatter.title}&nbsp;
                    <Icon name="mdi:arrow-top-right" />
                  </h4>
                  <p class="list-group-item-text">
                    <Icon name="mdi:calendar" />
                    &nbsp;{post.frontmatter.pubDate}
                  </p>
                  <small class="list-group-item-text">
                    {post.frontmatter.description}
                  </small>
                </a>
              );
            })
          }
        </div>
      </div>
    </div>
  </div>
</Layout>
