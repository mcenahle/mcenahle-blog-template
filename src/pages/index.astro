---
import Navbar from "../components/Navbar.astro";
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";

interface BlogModule {
  title: string;
  date: string;
  description: string;
  originalLink: string;
}

const modules = import.meta.glob<BlogModule>("./*.astro", {
  eager: true,
});

const posts = Object.entries(modules)
  // 排除博客首页自己
  .filter(([path]) => path !== "./index.astro")

  // 整理文章信息
  .map(([path, post]) => {
    const filename = path.replace("./", "").replace(".astro", "");

    return {
      title: post.title,
      date: post.date,
      description: post.description,
      url: `/${filename}/`,
    };
  })

  // 按日期从新到旧排列
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<Navbar />

<Layout title="主页">
  <div class="container">
    <div class="post">
      <div class="border-bottom">
        <h2 class="text-black">natsume</h2>

        <p>一个来自 Mcenahle 搭建的 Astro 网站主题。</p>

        <div class="list-group">
          <a href="/2026/08/26/example-post/" class="list-group-item active">
            <h4 class="list-group-item-heading">
              示例博客文章 <Icon name="mdi:arrow-top-right" />
            </h4>
            <p class="list-group-item-text">这是一篇示例的博客文章。</p>
          </a>
          <a href="/2026/08/27/example-post-2/" class="list-group-item">
            <h4 class="list-group-item-heading">
              示例博客文章（2） <Icon name="mdi:arrow-top-right" />
            </h4>
            <p class="list-group-item-text">这是另一篇示例的博客文章。</p>
          </a>
        </div>
      </div>
    </div>

