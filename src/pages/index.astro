---
import Navbar from "../components/Navbar.astro";
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";

const allPosts = Object.values(
  import.meta.glob("../posts/*.md", { eager: true }),
).sort(
  (a: any, b: any) =>
    new Date(b.frontmatter.pubDate).getTime() -
    new Date(a.frontmatter.pubDate).getTime(),
);
---

<Navbar />

<Layout title="主页">
  <div class="container">
    <div class="post">
      <div class="border-bottom">
        <h2 class="text-black">natsume</h2>

        <p>一个来自 Mcenahle 搭建的 Astro 网站主题。</p>

        <ul style="text-indent: 0em;">
          {
            allPosts.map((post: any) => {
              const [year, month, day] = post.frontmatter.pubDate.split("-");

              const url = `/${year}/${month}/${day}/${post.frontmatter.slug}/`;

              return (
                <li>
                  <a href={url}>
                    <u>{post.frontmatter.title}</u>{" "}
                    <Icon name="mdi:arrow-top-right" />
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>
  </div>
</Layout>
